# ==========================================
# Root .gitignore for CareerSaathi Project
# ==========================================

# Dependencies
node_modules/
**/node_modules/

# Python Virtual Environments
.venv/
**/venv/
**/env/

# Python Byte Code & Cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Next.js Build Output
.next/
**/.next/
out/
build/

# Environment Variables & Secret Credentials
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Local SQLite Databases
*.db
*.sqlite
*.sqlite3

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel / Turbopack
.vercel
.turbo

# OS & Editor generated files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

